# Which skin and test-data set to use: tine (default) or waretrack.
VITE_BRAND=tine

# Leave empty to run on built-in test data with a live simulation.
# Set to your backend to use real data. See src/api/httpSource.ts for the expected endpoints.
VITE_WARETRACK_API_URL=
# Optional bearer token (disables SSE, uses polling instead).
VITE_WARETRACK_API_TOKEN=
VITE_WARETRACK_POLL_MS=2000
